# --- Local development (SQLite + disk) ---
DATABASE_URL=file:./data/portal.db
STORAGE_PATH=./storage
STAFF_PASSWORD_HASH=
SESSION_SECRET=change-me-in-production

# --- Production on Vercel (Firebase + Blob) ---
# DATA_BACKEND=firebase
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# BLOB_READ_WRITE_TOKEN=   # injected when a Blob store is linked in Vercel
# NEXT_PUBLIC_USE_BLOB_UPLOADS=true   # required on Vercel for client uploads up to 7 MB
# STAFF_PASSWORD_HASH=
# SESSION_SECRET=
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional upload cap in bytes (default 7 MB)
# NEXT_PUBLIC_MAX_CLIENT_FILE_BYTES=7340032

# Branding — see docs/BRANDING.md
# NEXT_PUBLIC_FIRM_NAME=Document upload
# NEXT_PUBLIC_FIRM_LOGO_URL=/brand/firm-logo.svg
# NEXT_PUBLIC_CLIENT_PORTAL_DOMAIN=documents.yourfirm.co.uk
# NEXT_PUBLIC_PRIVACY_URL=https://yourfirm.co.uk/privacy
# NEXT_PUBLIC_FIRM_CONTACT_EMAIL=hello@yourfirm.co.uk

# Optional: show OneDrive export stub in staff UI
# NEXT_PUBLIC_FEATURE_ONEDRIVE_EXPORT=false
