# --- Local API mode (SQLite + disk) ---
# DATABASE_URL=file:./data/portal.db
# STORAGE_PATH=./storage

# --- Production (Vercel + Firebase Spark) — project checklistapp-ab71c ---
# DATA_BACKEND=firebase
# FIREBASE_PROJECT_ID=checklistapp-ab71c
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@checklistapp-ab71c.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=checklistapp-ab71c.firebasestorage.app
# (Web SDK apiKey is NOT used server-side; get Admin key from Service accounts.)

# bcrypt hash for staff login (required in production API mode)
# STAFF_PASSWORD_HASH=

# Signs staff session cookie (required when using API auth in production)
# SESSION_SECRET=change-me-in-production

# Client uses API when false; uses browser mock store when true (default).
# On Vercel with Firebase: set false. For pitch-only demo: true.
NEXT_PUBLIC_USE_MOCK_STORE=true

# Canonical app URL for publish links (set in Vercel Production)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional upload cap in bytes (default 4MB on Vercel, 7MB local)
# NEXT_PUBLIC_MAX_CLIENT_FILE_BYTES=4194304

# Branding (Prompt 4.1) — see docs/BRANDING.md
# NEXT_PUBLIC_FIRM_NAME=L-Cedar Immigration
# NEXT_PUBLIC_FIRM_LOGO_URL=/brand/firm-logo.svg
# NEXT_PUBLIC_CLIENT_PORTAL_DOMAIN=documents.yourfirm.co.uk
# NEXT_PUBLIC_PRIVACY_URL=https://yourfirm.co.uk/privacy
# NEXT_PUBLIC_FIRM_CONTACT_EMAIL=hello@yourfirm.co.uk

# Phase 4 feature flags (default off)
# NEXT_PUBLIC_FEATURE_ONEDRIVE_EXPORT=false
# NEXT_PUBLIC_FEATURE_MULTI_ROUTE=false
# NEXT_PUBLIC_FEATURE_CLIENT_PIN=false
